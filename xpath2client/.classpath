<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="src" path="src"/>
	<classpathentry combineaccessrules="false" kind="src" path="/org.eclipse.wst.xml.xpath2.processor"/>
	<!-- not xml-apis.jar: the JDK has those classes -->
	<classpathentry kind="lib" path="/org.apache.xerces/lib/xercesImpl.jar"/>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
