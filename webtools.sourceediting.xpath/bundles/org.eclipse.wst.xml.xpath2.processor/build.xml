<project name="proj1" default="generate_parser" basedir=".">
    <property name="src" location="${basedir}"/>   
    <property name="cupJar" location="${basedir}/lib/javacup10.jar"/>
    <property name="jflexJar" location="${basedir}/lib/JFlex.jar"/>
    <property name="maven.repo" value="https://repo1.maven.org/maven2"/>
    <property name="internalSrc" location="${basedir}/src/org/eclipse/wst/xml/xpath2/processor/internal"/>
    <description>
    Build File for Compiler Project
</description>

	<!-- the versions that generated the parser and the lexer -->
	<target name="download_tools">
		<mkdir dir="${basedir}/lib"/>
		<get src="${maven.repo}/de/jflex/jflex/1.4.3/jflex-1.4.3.jar" dest="${jflexJar}" skipexisting="true"/>
		<get src="${maven.repo}/edu/princeton/cup/java-cup/10k/java-cup-10k.jar" dest="${cupJar}" skipexisting="true"/>
	</target>

	<target name="generate_parser" depends="download_tools">
		<taskdef classname="JFlex.anttask.JFlexTask" name="jflex" classpath="${jflexJar}" />
		<!-- JFlex skips the generation when the lexer looks up to date -->
		<delete file="${internalSrc}/XPathFlex.java"/>
		<jflex file="grammars/xpath.lex" destdir="${basedir}/src"/>
		<!-- the jar on Maven Central has no Main-Class -->
	    <java classname="java_cup.Main" classpath="${cupJar}" input="grammars/xpath.cup" output="${basedir}/JavaCUP-dump.txt" fork="true" failonerror="true">
	    	<arg value="-parser"/>
	    	<arg value="XPathCup"/>
	    	<arg value="-symbols"/>
	    	<arg value="XpathSym"/>
	    	<arg value="-package"/>
	    	<arg value="org.eclipse.wst.xml.xpath2.processor.internal"/>
	    	<arg value="-dump"/>    	
	    </java>
		<move tofile="${internalSrc}/XPathCup.java" file="XPathCup.java" overwrite="true"/>
		<move tofile="${internalSrc}/XpathSym.java" file="XpathSym.java" overwrite="true"/>
		<!-- the CUP runtime is included in the processor -->
		<replace token="java_cup.runtime" value="org.eclipse.wst.xml.xpath2.processor.internal.cup">
			<fileset dir="${internalSrc}" includes="XPathCup.java,XPathFlex.java"/>
		</replace>
		<!-- drop the dates and the local path, so that the CI can check that the committed files are up to date -->
		<replaceregexp flags="m" match="^(// The following code was generated by CUP v0\.10k\r?\n)// .*\r?\n" replace="\1">
			<fileset dir="${internalSrc}" includes="XPathCup.java,XpathSym.java"/>
		</replaceregexp>
		<replaceregexp file="${internalSrc}/XPathCup.java" flags="m" match="^  \* @version .*\r?\n" replace=""/>
		<replaceregexp file="${internalSrc}/XPathFlex.java" match="(generated by JFlex 1\.4\.3) on .* \*/" replace="\1 */"/>
		<replaceregexp file="${internalSrc}/XPathFlex.java" match=" \* on .* (from the specification file)" replace=" * \1"/>
		<replaceregexp file="${internalSrc}/XPathFlex.java" match="&lt;tt&gt;.*xpath\.lex&lt;/tt&gt;" replace="&lt;tt&gt;grammars/xpath.lex&lt;/tt&gt;"/>
	</target>

</project>