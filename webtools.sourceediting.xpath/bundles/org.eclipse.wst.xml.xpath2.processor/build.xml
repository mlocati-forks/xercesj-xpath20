<project name="proj1" default="generate_parser" basedir=".">
    <property name="src" location="${basedir}"/>   
    <property name="cupJar" location="${basedir}/lib/javacup10.jar"/>
    <property name="jflexJar" location="${basedir}/lib/JFlex.jar"/>
    <property name="maven.repo" value="https://repo1.maven.org/maven2"/>
    <description>
    Build File for Compiler Project
</description>

	<!-- the versions that generated the parser and the lexer -->
	<target name="download_tools">
		<mkdir dir="${basedir}/lib"/>
		<get src="${maven.repo}/de/jflex/jflex/1.4.3/jflex-1.4.3.jar" dest="${jflexJar}" skipexisting="true"/>
		<get src="${maven.repo}/edu/princeton/cup/java-cup/10k/java-cup-10k.jar" dest="${cupJar}" skipexisting="true"/>
	</target>

	<target name="generate_parser" depends="download_tools">
		<taskdef classname="JFlex.anttask.JFlexTask" name="jflex" classpath="${jflexJar}" />
		<jflex file="grammars/xpath.lex" destdir="grammars/generated"/>
		<!-- the jar on Maven Central has no Main-Class -->
	    <java classname="java_cup.Main" classpath="${cupJar}" input="grammars/xpath.cup" output="${basedir}/JavaCUP-dump.txt" fork="true" failonerror="true">
	    	<arg value="-parser"/>
	    	<arg value="XPathCup"/>
	    	<arg value="-symbols"/>
	    	<arg value="XpathSym"/>
	    	<arg value="-package"/>
	    	<arg value="org.eclipse.wst.xml.xpath2.processor.internal"/>
	    	<arg value="-dump"/>    	
	    </java>
		<move tofile="${basedir}/src/org/eclipse/wst/xml/xpath2/processor/internal/XPathCup.java" file="XPathCup.java"/>
		<move tofile="${basedir}/src/org/eclipse/wst/xml/xpath2/processor/internal/XpathSym.java" file="XpathSym.java"/>
		<!-- the CUP runtime is included in the processor -->
		<replace token="java_cup.runtime" value="org.eclipse.wst.xml.xpath2.processor.internal.cup">
			<fileset dir="grammars/generated" includes="**/*.java"/>
			<fileset file="${basedir}/src/org/eclipse/wst/xml/xpath2/processor/internal/XPathCup.java"/>
		</replace>
	</target>

</project>